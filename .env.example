# Copy to .env (gitignored). Docker Compose reads .env for interpolation.
# OpenCode also reads these from the container environment.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Only needed if you start `opencode web` inside the container.
OPENCODE_SERVER_PASSWORD=

# Optional (docker compose only; run.sh always matches the invoking user):
# run the container as your host user so files it creates under
# ./agentic-browser and ./screenshots aren't owned by root. Fill in with
# `id -u` / `id -g`. Leave unset to keep running as root.
HOST_UID=
HOST_GID=
